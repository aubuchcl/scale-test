{
  "id": "s6-limits",
  "title": "max and max_server",
  "purpose": "Demand for ~3 cores with max 2 and max_server 2, all on one server. If max_server is a per-server cap, the peak is 2; if it is a minimum (as the API spec says), the peak is 3 (base + max).",
  "scale": {
    "autoscale_group": null,
    "window": "2m",
    "instances": {
      "max": 2,
      "max_server": 2,
      "min_ttl": "5m"
    },
    "thresholds": [
      {
        "type": "cpu",
        "details": {
          "utilization": 30
        }
      }
    ]
  },
  "load": {
    "type": "loadgen",
    "env": {
      "RAMP": "2m",
      "HOLD": "12m",
      "DOWN": "30s",
      "SCENARIO": "cpu",
      "RATE": "30",
      "BURN_MS": "100"
    }
  },
  "observe_after_load": "15m",
  "timeout": "50m",
  "expect": {
    "scale_up_within": "8m",
    "peak_at_most": 3,
    "respects_min_ttl": true,
    "back_to_base_within": "15m"
  }
}
