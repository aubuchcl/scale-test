{
  "name": "scale-test",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible test lab for Cycle container auto-scaling and auto-scale groups",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preflight": "tsx scripts/preflight.ts",
    "status": "tsx scripts/status.ts",
    "validate": "tsx scripts/validate.ts",
    "stacks": "tsx scripts/stacks.ts",
    "apply": "tsx scripts/apply.ts",
    "scenario": "tsx scripts/scenario.ts",
    "collect": "tsx scripts/collect.ts",
    "reset": "tsx scripts/reset.ts",
    "teardown": "tsx scripts/teardown.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/lib/retryFetch.test.ts"
  },
  "dependencies": {
    "@cycleplatform/api-client-typescript": "0.3.31"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11.7.2",
    "@types/node": "22.20.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
